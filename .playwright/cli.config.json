{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true,
      "channel": "chromium"
    },
    "contextOptions": {
      "viewport": {
        "width": 1280,
        "height": 800
      }
    }
  },
  "outputDir": ".playwright-cli",
  "outputMode": "file"
}
