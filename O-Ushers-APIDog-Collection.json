{
  "info": {
    "name": "O-Ushers API",
    "description": "Complete collection for O-Ushers backend — Auth, Admin, Organizer & Usher endpoints.",
    "version": "1.0.0",
    "schema": "https://schema.apidog.com/format/v3.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token",   "value": "",                      "type": "string" },
    { "key": "userId",  "value": "",                      "type": "string" },
    { "key": "eventId", "value": "",                      "type": "string" },
    { "key": "applicationId", "value": "",                "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ahmed Yousef\",\n  \"userName\": \"ahmedY\",\n  \"email\": \"ahmed@test.com\",\n  \"password\": \"Test@1234\",\n  \"mobileNumber\": \"01012345678\",\n  \"city\": \"Cairo\",\n  \"experience\": 2,\n  \"role\": \"usher\",\n  \"rate\": 5,\n  \"languages\": [\"Arabic\", \"English\"],\n  \"eventCategories\": [\"corporate\", \"wedding\"],\n  \"portfolio\": [{ \"link\": \"https://ahmed-portfolio.com\", \"title\": \"Events Work\" }]\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has data', () => pm.expect(pm.response.json()).to.have.property('data'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (saves token)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@test.com\",\n  \"password\": \"Test@1234\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has token', () => pm.expect(json.data).to.have.property('token'));",
                  "pm.collectionVariables.set('token', json.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Forget Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forget-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@test.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/verify-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@test.com\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/reset-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@test.com\",\n  \"newPassword\": \"NewPass@1234\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Get All Users (usher only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Talent Profile by ID (usher only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/talents/{{userId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Server up', () => pm.expect(pm.response.json().server).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },

