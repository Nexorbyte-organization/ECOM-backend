# Application (local frontend uses port 3001, backend uses 4000)
APP_ENV=dev
# Only for an intentionally disposable local DB; never enable on deployments.
DB_SYNC_ALTER=false
PORT=4000
BASE_URL=https://YOUR-PUBLIC-TEST-BACKEND.example.com
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# PostgreSQL and authentication
PG_URI=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PG_SSL=false
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Required only when running npm run seed:demo. Use a unique password (12+ characters).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional destructive legacy-demo cleanup; leave false for normal admin seeding.
SEED_DEMO_CLEANUP=false

# Existing email and image services
EMAIL_USER=
EMAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paymob Accept — Test Mode only
PAYMOB_MODE=test
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=sk_test_replace_me
PAYMOB_PUBLIC_KEY=pk_test_replace_me
PAYMOB_API_KEY=replace_me
PAYMOB_HMAC_SECRET=replace_me
# Comma-separated Test Integration IDs, for example Card and Mobile Wallet.
PAYMOB_INTEGRATION_IDS=123456,234567
# Required for Add Card and saved-card checkout: numeric Test Normal 3DS or Auth card ID with card saving enabled.
PAYMOB_CARD_INTEGRATION_ID=
# Optional only for reading cards saved before the encryption-key change.
PAYMOB_TOKEN_ENCRYPTION_KEY=

# Paymob Payouts Sandbox — optional until Paymob activates the account
PAYMOB_PAYOUT_BASE_URL=https://stagingpayouts.paymobsolutions.com
PAYMOB_PAYOUT_CLIENT_ID=
PAYMOB_PAYOUT_CLIENT_SECRET=
PAYMOB_PAYOUT_USERNAME=
PAYMOB_PAYOUT_PASSWORD=
PAYMOB_PAYOUT_HMAC_SECRET=
