{
  "info": {
    "name": "O-Ushers API",
    "description": "Complete APIDog collection for O-Ushers backend — Auth, Admin, Organizer & Usher endpoints.",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token",   "value": "",                      "type": "string" },
    { "key": "userId",  "value": "",                      "type": "string" },
    { "key": "eventId", "value": "",                      "type": "string" },
    { "key": "applicationId", "value": "",                "type": "string" }
