            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/usher/applications/my?filter=past",
              "query": [{ "key": "filter", "value": "past" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));"
        },
        {
          "name": "Event History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usher/events/history",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));"
        },
        {
          "name": "Excuse from Event",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/usher/applications/{{applicationId}}/excuse",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": { "reason": "Medical emergency" }
            }
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));"
        },
        {
          "name": "Refer a Talent",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/usher/refer",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": {
                "referredTalentId": "{{userId}}",
                "eventId": "{{eventId}}"
              }
            }
          },
          "test": "pm.test('Status 200 or 201', () => pm.expect([200,201]).to.include(pm.response.code));"
        },
        {
          "name": "View Talent Profile by ID (shared)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usher/profile/{{userId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));"
        },
        {
          "name": "Get Own Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usher/{{userId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));"
        }
      ]
    }

  ]
