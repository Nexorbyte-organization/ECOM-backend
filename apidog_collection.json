  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": {
                "fullName": "Ahmed Yousef",
                "userName": "ahmedY",
                "email": "ahmed@test.com",
                "password": "Test@1234",
                "mobileNumber": "01012345678",
                "city": "Cairo",
                "experience": 2,
                "role": "usher",
                "rate": 5,
                "languages": ["Arabic", "English"],
                "eventCategories": ["corporate", "wedding"],
                "portfolio": [{ "link": "https://ahmed-portfolio.com", "title": "Events Work" }]
              }
            }
          },
          "test": "pm.test('Status 201', () => pm.response.to.have.status(201));\npm.test('Has data', () => pm.expect(pm.response.json()).to.have.property('data'));"
        },
        {
          "name": "Login (saves token)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": {
                "email": "ahmed@test.com",
                "password": "Test@1234"
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": "pm.test('Status 200', () => pm.response.to.have.status(200));\nconst json = pm.response.json();\npm.test('Has token', () => pm.expect(json.data).to.have.property('token'));\npm.collectionVariables.set('token', json.data.token);"
            }
          ]
        },
        {
          "name": "Forget Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forget-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": { "email": "ahmed@test.com" }
            }
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));"
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/verify-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": { "email": "ahmed@test.com", "otp": "123456" }
            }
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));"
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/reset-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": { "email": "ahmed@test.com", "newPassword": "NewPass@1234" }
            }
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));"
        },
        {
          "name": "Get All Users (usher only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));\npm.test('Has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
        },
        {
          "name": "Get Talent Profile by ID (usher only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/talents/{{userId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));"
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "test": "pm.test('Status 200', () => pm.response.to.have.status(200));\npm.test('Server up', () => pm.expect(pm.response.json().server).to.be.true);"
        }
      ]
    },

